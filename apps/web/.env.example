# Supabase local (pnpm db:start mostra os valores). Em produção, os do projeto na Vercel.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Endereço público do painel (links do e-mail de acesso).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Servidor do painel (nunca expor ao navegador): webhook do WhatsApp.
SUPABASE_SECRET_KEY=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Número da Givance mostrado na tela de WhatsApp, ex.: +55 11 99999-0000
NEXT_PUBLIC_WHATSAPP_NUMERO_GIVANCE=
