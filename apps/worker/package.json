{
  "name": "@givance/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --dir src",
    "test:integration": "vitest run --dir tests",
    "spike:agent-sdk": "tsx --env-file-if-exists=.env src/spikes/agent-sdk.ts",
    "roles:publish": "tsx --env-file-if-exists=.env src/cli/publicar-cargos.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.325",
    "@givance/agents": "workspace:*",
    "@givance/core": "workspace:*",
    "@givance/db": "workspace:*",
    "@givance/integrations": "workspace:*",
    "@givance/tools": "workspace:*",
    "sharp": "^0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
