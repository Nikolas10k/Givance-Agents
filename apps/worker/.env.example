# Copie para apps/worker/.env (não versionado).
# Local: valores de `pnpm exec supabase status` (API_URL e SECRET_KEY).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
# Chave da API da Anthropic (Console > API Keys). Sem ela, as tarefas falham com explicação.
ANTHROPIC_API_KEY=
WORKER_CONCURRENCY=2
LOG_LEVEL=info

# WhatsApp Cloud API (número da Givance). Sem estes dois, o canal fica desligado.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_AVISO=givance_aviso
WHATSAPP_TEMPLATE_CONFIRMACAO=givance_confirmacao
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
